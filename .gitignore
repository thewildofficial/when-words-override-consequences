.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

# Generated artifacts. Keep directory README files and lightweight summaries.
artifacts/raw/*
!artifacts/raw/.gitkeep
artifacts/processed/*
!artifacts/processed/.gitkeep
artifacts/figures/*
!artifacts/figures/.gitkeep
# Local prepare scratch (tokenizer output). Scored-run copies live under
# results/report_reactivity/<run_id>/prepared.json.gz and are committed.
artifacts/prepared/*
!artifacts/prepared/.gitkeep
artifacts/cache/

# Local operational controls; not part of the public research narrative.
docs/compute-budget.md

# V6.1's generated row table is deterministic output of the committed
# generator. The CPU control step regenerates it, verifies the manifest hash,
# and freezes it before any Modal stage.
configs/v6.1/epistemic_repair/dataset.json
